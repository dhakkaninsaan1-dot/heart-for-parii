<!DOCTYPE html>
<html>
<head>
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/brython@3.11.0/brython.min.js"></script>
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/brython@3.11.0/brython_modules.js"></script>
    <style>
        body { margin: 0; background-color: black; display: flex; justify-content: center; align-items: center; height: 100vh; overflow: hidden; }
        canvas { border: none; }
    </style>
</head>
<body onload="brython()">

    <div id="turtle-div"></div>

    <script type="text/python">
import math
import turtle

# Canvas ko body ke andar set krna
turtle.set_background_color("black")

t_draw = turtle.Turtle()
t_draw.speed(0)
t_draw.color("red")

def heart_x(t):
    return 16 * math.sin(t)**3

def heart_y(t):
    return 13 * math.cos(t) - 5 * math.cos(2*t) - 2 * math.cos(3*t) - math.cos(4*t)

points = []
for i in range(60):  # Web k liye 60 points smooth rahenge
    t = (2 * math.pi * i) / 60
    x = heart_x(t) * 12
    y = heart_y(t) * 12
    points.append((x, y))

# Text likhna
t_draw.keyup()
t_draw.goto(0, 200)
t_draw.keydown()
t_draw.write("Heart for parii❤️", align="center", font=("Arial", 18, "bold"))

# Main drawing loop
for p1 in points:
    for p2 in points:
        t_draw.keyup()
        t_draw.goto(p1[0], p1[1])
        t_draw.keydown()
        t_draw.goto(p2[0], p2[1])

t_draw.hideturtle()
    </script>
</body>
</html>
